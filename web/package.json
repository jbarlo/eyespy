{
  "name": "eyespy-web",
  "version": "0.1.0",
  "private": true,
  "description": "eyespy web app: find and catalogue the objects in a video, locally in your browser",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p test",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "node --import tsx scripts/check.ts"
  },
  "dependencies": {
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "mp4box": "2.4.1",
    "neverthrow": "catalog:",
    "onnxruntime-web": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "eyespy-core": "workspace:*",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright-core": "1.64.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
